# Copy to .env and fill in. Never commit real values.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sportai:CHANGE_ME@localhost:5432/sportai

# --- Data mode: "simulation" (fictional league, never publishable) or "real" ---
DATA_MODE=simulation

# --- Data providers (real mode) ---
API_FOOTBALL_KEY=            # https://dashboard.api-football.com  (header x-apisports-key)
THE_ODDS_API_KEY=            # https://the-odds-api.com
ODDS_REGIONS=fr              # fr region includes winamax_fr, betclic_fr, unibet_fr, pmu_fr, netbet_fr
ODDS_BOOKMAKERS=             # optional, e.g. winamax_fr,betclic_fr (overrides ODDS_REGIONS)

# --- Shopify ---
SHOPIFY_WEBHOOK_SECRET=      # app client secret used to sign webhooks

# --- Claude (QC / news review agent) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_BUDGET_USD_PER_RUN=0.50

# --- Web / sessions ---
COOKIE_SECURE=true           # false only for local http
SESSION_DAYS=14
BACKEND_URL=http://127.0.0.1:8000   # used by the Next.js proxy

# --- Worker ---
PREMATCH_INTERVAL_MIN=360
LIVE_INTERVAL_S=60
